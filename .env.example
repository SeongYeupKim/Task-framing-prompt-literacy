# OpenAI (server only — never expose to client)
OPENAI_API_KEY=
# Model id (e.g. gpt-4o-mini). Use your project’s approved model name.
# Use the model ID enabled for your API key (e.g. gpt-4o-mini, or your project-specific name).
OPENAI_MODEL=gpt-4o-mini

# Firebase (client — safe to expose with proper Firestore rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Researcher /admin (server — checked only in API routes)
# If unset, defaults are username admin and password mattandseong. Set these on Vercel to override.
ADMIN_DASHBOARD_USERNAME=
ADMIN_DASHBOARD_PASSWORD=
# Legacy alias for password (used if ADMIN_DASHBOARD_PASSWORD is empty)
# ADMIN_EXPORT_SECRET=

# Optional: Firebase Auth email for one-step /admin export (same password as dashboard).
# Register this @psu.edu user in Firebase with the same password as ADMIN_DASHBOARD_PASSWORD / default.
# Client can also use NEXT_PUBLIC_EXPORT_FIREBASE_EMAIL instead (see below).
ADMIN_EXPORT_FIREBASE_EMAIL=

# Optional (client): if set, used for auto Firebase sign-in after admin login when server export is off.
# Same password as dashboard. Overrides calling /api/admin/firebase-bridge for the email.
# NEXT_PUBLIC_EXPORT_FIREBASE_EMAIL=

# Firebase Admin SDK — optional; enables /api/admin/export-csv (read all users) without browser Firebase
# A) One-line service account JSON:  jq -c . your-key.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# B) Or three separate vars:
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=   # PEM; use \n for line breaks in the string if needed
