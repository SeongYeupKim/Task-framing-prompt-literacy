# OpenAI (server only — never expose to client)
OPENAI_API_KEY=
# Model id (e.g. gpt-4o-mini). Use your project’s approved model name.
# Use the model ID enabled for your API key (e.g. gpt-4o-mini, or your project-specific name).
OPENAI_MODEL=gpt-4o-mini

# Firebase (client — safe to expose with proper Firestore rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Researcher /admin (server — never expose password in client bundle; values checked on API only)
ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD=

# Firebase Admin SDK — required for /api/admin/export-csv (read all users)
# A) One-line service account JSON:  jq -c . your-key.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# B) Or three separate vars:
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=   # PEM; use \n for line breaks in the string if needed
