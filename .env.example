# OpenAI (server only — never expose to client)
OPENAI_API_KEY=
# Model id (e.g. gpt-4o-mini). Use your project’s approved model name.
# Use the model ID enabled for your API key (e.g. gpt-4o-mini, or your project-specific name).
OPENAI_MODEL=gpt-4o-mini

# Firebase (client — safe to expose with proper Firestore rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Researcher-only data export (/admin) — server secrets, never expose to the browser bundle
# Long random string; use the same value in the admin UI password field.
ADMIN_EXPORT_SECRET=
# Full JSON of a Firebase service account key (Project settings → Service accounts → Generate new private key).
# Paste as one line in Vercel, or use .env.local for local testing. Grants read access to Firestore.
FIREBASE_SERVICE_ACCOUNT_JSON=
