rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isResearchExportAccount() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'admin@psu.edu';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Same account as /admin browser export (admin@psu.edu). Change both here and
      // RESEARCH_EXPORT_FIREBASE_EMAIL / NEXT_PUBLIC_RESEARCH_EXPORT_EMAIL if needed.
      allow read: if isResearchExportAccount();
    }
  }
}
