rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Researcher allow-list: doc id = Firebase Auth UID. Create in Console only.
    match /researchers/{researcherId} {
      allow read: if request.auth != null && request.auth.uid == researcherId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/researchers/$(request.auth.uid));
    }
  }
}
